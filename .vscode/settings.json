{
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.tsconfig.fallback": "./tsconfig.vscode.json",
  "typescript.preferences.includePackageJsonAutoImports": "on",
  "typescript.tsc.autoDetect": "off",
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit"
  },
  "cSpell.words": [
    "lerp",
    "lerpColor",
    "ansimax",
    "figlet",
    "typewriter",
    "sgr",
    "brightBlack",
    "brightRed",
    "brightGreen",
    "brightYellow",
    "brightBlue",
    "brightMagenta",
    "brightCyan",
    "brightWhite",
    "nocolor",
    "tsup",
    "tsconfig",
    "biome",
    "biomejs"
  ],
  "files.exclude": {
    "dist": false,
    "dist-test": false,
    "coverage": false
  },
  "explorer.excludeGitIgnore": false,
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  }
}
