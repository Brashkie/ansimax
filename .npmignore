# ─────────────────────────────────────────────
#  .npmignore — files NOT included in the npm tarball
#
#  SOURCE OF TRUTH is package.json "files":
#      ["dist", "examples", "docs", "README.md",
#       "README.es.md", "CHANGELOG.md", "LICENSE"]
#  "files" is a whitelist and it WINS over this file. Anything it lists
#  ships even if a rule below matches it — so `examples/` and `docs/` are
#  published on purpose. This file only prunes paths *inside* those
#  directories, and keeps npm from falling back to .gitignore (which
#  ignores dist/ — the one directory the package must ship).
#
#  Verify before releasing:  npm pack --dry-run
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
#  Source code (only ship the build)
# ─────────────────────────────────────────────
src/
tests/
__tests__/
test/
demo/
scripts/
examples/**/*.test.ts
examples/node_modules/

# ─────────────────────────────────────────────
#  Config files
# ─────────────────────────────────────────────
.github/
.vscode/
.idea/
.husky/
bench/
bench-result.*
*.config.js
*.config.ts
*.config.cjs
*.config.mjs
tsconfig*.json
jest.config.*
tsup.config.*
biome.json
biome.jsonc
.editorconfig
.gitignore
.gitattributes

# ─────────────────────────────────────────────
#  Documentation (whitelist what ships)
# ─────────────────────────────────────────────
*.md
!README.md
!README.es.md
!CHANGELOG.md
!LICENSE
!LICENSE.md

docs-site/
.readme/

# ─────────────────────────────────────────────
#  Media (videos and screenshots stay on GitHub)
# ─────────────────────────────────────────────
media/
*.mp4
*.mov
*.gif

# ─────────────────────────────────────────────
#  CI / CD
# ─────────────────────────────────────────────
.travis.yml
.gitlab-ci.yml
.circleci/
codecov.yml
.codecov.yml
azure-pipelines.yml

# ─────────────────────────────────────────────
#  Build artifacts and caches
# ─────────────────────────────────────────────
coverage/
.nyc_output/
*.tsbuildinfo
.cache/
.parcel-cache/
.turbo/
.biome-cache

# ─────────────────────────────────────────────
#  Logs and runtime
# ─────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─────────────────────────────────────────────
#  OS files
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─────────────────────────────────────────────
#  Environment
# ─────────────────────────────────────────────
.env
.env.*

# ─────────────────────────────────────────────
#  Other
# ─────────────────────────────────────────────
*.tgz
__snapshots__/
.test-output/